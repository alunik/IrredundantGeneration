{
  "schema_version": 3,
  "purpose": "Record group-specific targets for the group-agnostic computation framework. Ambient upper bounds always compute the member-class filter dynamically before building the conjugation action.",
  "generic_gap_entrypoints": {
    "tuple_verifier": "gap/verify_irredundant_tuple_from_images.g",
    "member_filter": "gap/run_member_filter.g",
    "proper_subgroup_upper": "gap/run_proper_subgroup_upper.g",
    "cached_or_prefix_upper": "gap/run_cached_upper_bound.g",
    "action_builder": "gap/build_action_workspace.g"
  },
  "python_tools": {
    "emit_gap_commands": "python/emit_gap_commands.py",
    "spec_validator": "python/validate_computation_specs.py",
    "tuple_json": "python/verify_tuple_json.py",
    "prefix_certificate": "python/validate_prefix_certificate.py",
    "weakgp_cover": "python/validate_weakgp_cover.py",
    "i_upper_manifest": "python/validate_i_upper_manifest.py",
    "member_filter_manifest": "python/validate_member_filter_manifest.py"
  },
  "groups": {
    "M11": {
      "m_upper": {
        "runner": "cached_or_prefix_upper",
        "filter": {
          "runner": "member_filter",
          "survivors_path": "workspaces/m11_survivors.gaplist",
          "excluded_path": "workspaces/m11_excluded.gaplist"
        },
        "action": {
          "builder": "action_builder",
          "workspace": "workspaces/m11_action.ws",
          "selected_classes": "from_member_filter",
          "selected_classes_path": "workspaces/m11_survivors.gaplist",
          "build_once_reuse": true
        },
        "settings": {
          "TargetGroupName": "M11",
          "TargetLength": 6,
          "prefix": false
        }
      },
      "i_upper": {
        "runner": "proper_subgroup_upper",
        "settings": {
          "TargetGroupName": "M11",
          "TargetProperUpper": 6,
          "CheckStrongFlatTarget": 5,
          "SelectedTopClasses": "all"
        }
      }
    },
