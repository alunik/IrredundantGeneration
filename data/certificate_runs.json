{
  "schema_version": 1,
  "purpose": "Record the group-specific settings used with the group-agnostic runners.",
  "generic_gap_entrypoints": {
    "tuple_verifier": "gap/42_verify_irredundant_tuple_from_images.g",
    "ambient_upper": "gap/43_run_framework_upper_bound.g",
    "member_filter": "gap/44_run_framework_member_filter.g",
    "filtered_ambient_upper": "gap/45_run_framework_filtered_upper_bound.g",
    "proper_subgroup_upper": "gap/46_run_framework_proper_subgroup_upper.g",
    "cached_or_prefix_upper": "gap/47_run_framework_cached_upper_bound.g",
    "action_builder": "gap/30_build_action_workspace.g"
  },
  "python_validators": {
    "tuple_json": "python/verify_tuple_json.py",
    "prefix_certificate": "python/validate_prefix_certificate.py",
    "weakgp_cover": "python/validate_weakgp_cover.py",
    "i_upper_manifest": "python/validate_i_upper_manifest.py",
    "member_filter_manifest": "python/validate_member_filter_manifest.py"
  },
  "groups": {
    "J1": {
      "tuple_certificates": ["certs/j1_tuple4.json"],
      "m_upper": {
        "runner": "ambient_upper",
        "settings": { "TargetGroupName": "J1", "TargetLength": 5, "SelectedClasses": "all", "prefix": false, "member_filter": false },
        "logs": ["logs/j1_weakgp5_probe.log"]
      },
      "i_upper": {
        "runner": "proper_subgroup_upper",
        "settings": { "TargetGroupName": "J1", "TargetProperUpper": 5, "CheckStrongFlatTarget": 4, "SelectedTopClasses": "all" },
        "logs": ["logs/j1_i_upper.log"]
      }
    },
    "J2": {
      "tuple_certificates": ["certs/j2_tuple5.json"],
      "m_upper": {
        "runner": "ambient_upper",
        "settings": { "TargetGroupName": "J2", "TargetLength": 6, "SelectedClasses": "all", "prefix": false, "member_filter": false },
        "logs": ["logs/j2_weakgp6_probe.log"]
      },
      "i_upper": {
        "runner": "proper_subgroup_upper",
        "settings": { "TargetGroupName": "J2", "TargetProperUpper": 6, "CheckStrongFlatTarget": 5, "SelectedTopClasses": "all" },
        "logs": ["logs/j2_i_upper.log"]
      }
    },
    "J3": {
      "tuple_certificates": ["certs/j3_tuple4.json", "certs/j3_i5_irredundant_tuple.json"],
      "m_upper": {
        "runner": "cached_or_prefix_upper",
        "settings": {
          "TargetGroupName": "J3",
          "TargetLength": 5,
          "SelectedClasses": [1, 2, 3, 4, 6, 7, 8, 9],
          "prefix": true,
          "member_filter_log": "logs/j3_member_i4_filter.log",
          "prefix_file": "certs/j3_active_prefixes_v2.txt",
          "chunk_size": 4
        },
        "logs": [
          "logs/j3_active_depth2_map_v2_create.log",
          "logs/j3_active_v2_prefix_certificate_validation.log",
          "logs/j3_active_v2_weakgp_cover_validation.log"
        ]
      },
      "i_upper": {
        "runner": "proper_subgroup_upper",
        "settings": { "TargetGroupName": "J3", "TargetProperUpper": 6, "SelectedTopClasses": "all" },
        "logs": ["logs/j3_proper_i_upper_target6.log"]
      }
    },
    "M22": {
      "tuple_certificates": ["certs/m22_tuple6.json"],
      "m_upper": {
        "runner": "ambient_upper",
        "settings": { "TargetGroupName": "M22", "TargetLength": 7, "SelectedClasses": "all", "prefix": false, "member_filter": false },
        "logs": ["logs/m22_no_gp7_signature_orbits.log"]
      },
      "i_upper": {
        "runner": "proper_subgroup_upper",
        "settings": { "TargetGroupName": "M22", "TargetProperUpper": 6, "SelectedTopClasses": "all" },
        "logs": ["logs/m22_i_upper_strong_flat.log"]
      }
    },
    "M23": {
      "tuple_certificates": ["certs/m23_tuple6.json"],
      "m_upper": {
        "runner": "ambient_upper",
        "settings": { "TargetGroupName": "M23", "TargetLength": 7, "SelectedClasses": "all", "prefix": false, "member_filter": false },
        "logs": ["logs/m23_no_gp7_signature_branch1.log", "logs/m23_no_gp7_signature_branches2_7.log"]
      },
      "i_upper": {
        "runner": "proper_subgroup_upper",
        "settings": { "TargetGroupName": "M23", "TargetProperUpper": 7, "SelectedTopClasses": "all" },
        "logs": ["logs/m23_proper_i_upper.log"]
      }
    },
    "M24": {
      "tuple_certificates": ["certs/m24_tuple7.json", "certs/agl42_tuple7.json"],
      "m_upper": {
        "runner": "cached_or_prefix_upper",
        "settings": {
          "TargetGroupName": "M24",
          "TargetLength": 8,
          "SelectedClasses": [2, 3, 5, 7],
          "member_filter_excluded_classes": [1, 4, 6, 8, 9],
          "prefix": true
        },
        "manifest": "certs/m24_ambient_exclusion_manifest.json",
        "logs": ["logs/m24_current_weakgp_cover_validation.log"]
      },
      "i_upper": {
        "runner": "proper_subgroup_upper",
        "settings": { "TargetGroupName": "M24", "TargetProperUpper": 8, "SelectedTopClasses": "all", "ranged": true },
        "manifest": "certs/m24_i_upper_manifest.json"
      }
    },
    "HS": {
      "tuple_certificates": ["certs/hs_tuple7.json"],
      "m_upper": {
        "runner": "filtered_ambient_upper",
        "settings": { "TargetGroupName": "HS", "TargetLength": 8, "member_filter": true, "survivors": [5], "prefix": false },
        "manifest": "certs/hs_ambient_upper_manifest.json",
        "logs": ["logs/hs_member_i7_filter_current.log", "logs/hs_current_no_gp8_class5.log"]
      },
      "i_upper": {
        "runner": "proper_subgroup_upper",
        "settings": { "TargetGroupName": "HS", "TargetProperUpper": 8, "SelectedTopClasses": "all", "ranged": true },
        "logs": ["logs/hs_i_upper_manifest.md"]
      }
    },
    "McL": {
      "tuple_certificates": ["certs/mcl_tuple6.json"],
      "m_upper": {
        "runner": "cached_or_prefix_upper",
        "settings": {
          "TargetGroupName": "McL",
          "TargetLength": 7,
          "SelectedClasses": [1, 2, 3, 6, 7, 8, 9, 10],
          "member_filter_excluded_classes": [4, 5, 11, 12],
          "prefix": true,
          "prefix_file": "certs/mcl_survivor_prefixes_oldmap_lean.txt",
          "chunk_size": 4
        },
        "logs": [
          "logs/mcl_survivor_depth2_map_cert_create.log",
          "logs/mcl_survivor_prefix_certificate_validation.log",
          "logs/mcl_survivor_weakgp_cover_validation.log"
        ]
      },
      "i_upper": {
        "runner": "proper_subgroup_upper",
        "settings": { "TargetGroupName": "McL", "TargetProperUpper": 7, "SelectedTopClasses": "all", "ranged": true },
        "logs": ["logs/mcl_i_upper_manifest.md", "logs/u43_proper_i_upper_target7.log"]
      }
    }
  }
}
